  "metric_definitions": {
    "clock": "client side, inside `vllm bench serve` (time.perf_counter)",
    "start_s": "when the request was sent, relative to the first request of the run",
    "client_queue_s": "time a request waited in the client for a free concurrency slot before it was sent; not part of any latency below",
    "ttft_s": "time from sending the request to receiving the first output token",
    "e2e_s": "time from sending the request to receiving the last output token",
    "tpot_s": "(e2e_s - ttft_s) / (output_tokens - 1): mean gap between output tokens after the first",
    "duration_s": "last response end minus first request start, from the rows",
    "output_tok_per_s": "sum of output_tokens of completed requests / duration_s",
    "requests_per_s": "completed requests / duration_s",
    "percentiles": "numpy.percentile with linear interpolation over the completed requests of one run (500 in the main matrix)",
    "burst": "the first `concurrency` requests by start time: they are sent together at t=0 and queue behind each other",
    "steady": "every request after the burst",
    "peak_in_flight": "largest number of requests between send and last token at any instant, from the rows; an end within 1 microsecond of a start counts as before it",
    "cache_hit_rate": "prefix_cache_hits / prefix_cache_queries, both as counter differences between the snapshot after warm-up and the snapshot after the measured requests",
